{
  "openapi": "3.0.3",
  "info": {
    "title": "Usage Metering and Quota Service API",
    "version": "1.0.0",
    "description": "Account-aware usage metering with API-key authentication, tenant-owned plans, atomic quota decisions, idempotency, and monthly usage history. Numeric quota values backed by PostgreSQL BIGINT are serialized as decimal strings in responses."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current host"
    }
  ],
  "tags": [
    { "name": "System", "description": "Service health." },
    { "name": "Accounts", "description": "Account onboarding, identity, and account-plan assignment." },
    { "name": "Users", "description": "Tenant-scoped users and user-plan assignment." },
    { "name": "Plans", "description": "Global predefined plans and tenant-owned custom plans." },
    { "name": "Usage", "description": "Atomic quota decisions, counters, and decision history." }
  ],
  "security": [
    { "apiKey": [] }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Check service health",
        "description": "Public process-level health check used by Docker and deployment verification.",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "The API process is healthy.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": { "status": "ok" }
              }
            }
          }
        }
      }
    },
    "/accounts": {
      "post": {
        "tags": ["Accounts"],
        "summary": "Create an account",
        "description": "Creates an account on the predefined Starter ACCOUNT plan and returns a one-time API key. Only the key hash is persisted.",
        "operationId": "createAccount",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateAccountRequest" },
              "example": { "name": "DocuApp" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created. The API key is returned only in this response and is intentionally represented by a non-secret placeholder below.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateAccountResponse" },
                "example": {
                  "account": {
                    "id": "f4f734c2-ff65-4aac-9da9-64583c476c92",
                    "name": "DocuApp",
                    "plan": {
                      "id": "c932cad1-55b9-41b0-9480-2ae4b6297375",
                      "name": "Starter"
                    }
                  },
                  "apiKey": "<returned-once>"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": {
            "description": "The client-IP account creation limit was exceeded.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until another attempt is allowed.",
                "schema": { "type": "integer" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RateLimitError" },
                "example": {
                  "statusCode": 429,
                  "error": "Too Many Requests",
                  "message": "Too many account creation requests. Please try again later."
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/me": {
      "get": {
        "tags": ["Accounts"],
        "summary": "Get the authenticated account",
        "description": "Resolves the account associated with the supplied API key.",
        "operationId": "getAuthenticatedAccount",
        "responses": {
          "200": {
            "description": "Authenticated account identity.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthenticatedAccountResponse" },
                "example": {
                  "account": {
                    "id": "f4f734c2-ff65-4aac-9da9-64583c476c92",
                    "name": "DocuApp"
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/account/plan": {
      "patch": {
        "tags": ["Accounts"],
        "summary": "Change the account plan",
        "description": "Assigns an accessible ACCOUNT-scoped plan to the authenticated account without resetting monthly usage.",
        "operationId": "changeAccountPlan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangePlanRequest" },
              "example": { "planId": "8d040520-a733-436b-b16a-652f59a38345" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The account now uses the requested plan.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccountWithPlanResponse" },
                "example": {
                  "account": {
                    "id": "f4f734c2-ff65-4aac-9da9-64583c476c92",
                    "name": "DocuApp",
                    "plan": {
                      "id": "8d040520-a733-436b-b16a-652f59a38345",
                      "name": "Pro"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/users": {
      "post": {
        "tags": ["Users"],
        "summary": "Create a user",
        "description": "Creates a tenant-scoped user on the predefined Basic USER plan. Account ownership always comes from the API key.",
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateUserRequest" },
              "example": { "externalUserId": "user_001" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserWithPlanResponse" },
                "example": {
                  "user": {
                    "id": "093320ba-afc2-4f11-b8b2-3ee085ff19c2",
                    "externalUserId": "user_001",
                    "plan": {
                      "id": "16488b72-a1b7-423d-b0d4-66c69fce4381",
                      "name": "Basic"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/users/{externalUserId}/plan": {
      "patch": {
        "tags": ["Users"],
        "summary": "Change a user's plan",
        "description": "Assigns an accessible USER-scoped plan to a user owned by the authenticated account without resetting usage.",
        "operationId": "changeUserPlan",
        "parameters": [
          { "$ref": "#/components/parameters/ExternalUserId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangePlanRequest" },
              "example": { "planId": "6b2cd0aa-2ac9-45e9-b54d-847543f838f7" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The user now uses the requested plan.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserWithPlanResponse" },
                "example": {
                  "user": {
                    "id": "093320ba-afc2-4f11-b8b2-3ee085ff19c2",
                    "externalUserId": "user_001",
                    "plan": {
                      "id": "6b2cd0aa-2ac9-45e9-b54d-847543f838f7",
                      "name": "Premium"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/plans": {
      "get": {
        "tags": ["Plans"],
        "summary": "List available plans",
        "description": "Returns global predefined plans plus custom plans owned by the authenticated account.",
        "operationId": "listPlans",
        "responses": {
          "200": {
            "description": "Plans visible to this account.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlanListResponse" },
                "example": {
                  "plans": [
                    {
                      "id": "16488b72-a1b7-423d-b0d4-66c69fce4381",
                      "name": "Basic",
                      "scope": "USER",
                      "monthlyAllowance": "1000",
                      "maxUnitsPerRequest": "100",
                      "isPredefined": true
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "post": {
        "tags": ["Plans"],
        "summary": "Create a custom plan",
        "description": "Creates an ACCOUNT- or USER-scoped custom plan owned by the authenticated account.",
        "operationId": "createPlan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePlanRequest" },
              "example": {
                "name": "Gold",
                "scope": "USER",
                "monthlyAllowance": 5000,
                "maxUnitsPerRequest": 100
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Custom plan created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlanResponse" },
                "example": {
                  "plan": {
                    "id": "6b2cd0aa-2ac9-45e9-b54d-847543f838f7",
                    "name": "Gold",
                    "scope": "USER",
                    "monthlyAllowance": "5000",
                    "maxUnitsPerRequest": "100",
                    "isPredefined": false
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/plans/{planId}": {
      "patch": {
        "tags": ["Plans"],
        "summary": "Update a custom plan",
        "description": "Updates the name or limits of a custom plan owned by the authenticated account. Scope and ownership are immutable.",
        "operationId": "updatePlan",
        "parameters": [
          { "$ref": "#/components/parameters/PlanId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdatePlanRequest" },
              "example": {
                "name": "Gold Plus",
                "monthlyAllowance": 7500,
                "maxUnitsPerRequest": 150
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Custom plan updated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlanResponse" },
                "example": {
                  "plan": {
                    "id": "6b2cd0aa-2ac9-45e9-b54d-847543f838f7",
                    "name": "Gold Plus",
                    "scope": "USER",
                    "monthlyAllowance": "7500",
                    "maxUnitsPerRequest": "150",
                    "isPredefined": false
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/usage/consume": {
      "post": {
        "tags": ["Usage"],
        "summary": "Consume usage",
        "description": "Atomically evaluates account and user quota limits. The requestId is account-scoped: an identical retry returns the original decision, while a conflicting payload returns 409.",
        "operationId": "consumeUsage",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConsumeUsageRequest" },
              "example": {
                "userId": "user_001",
                "units": 10,
                "requestId": "usage_001"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quota decision. Rejections are business decisions and also return HTTP 200 with accepted=false.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UsageDecision" },
                "examples": {
                  "accepted": {
                    "summary": "Accepted consumption",
                    "value": {
                      "accepted": true,
                      "requestId": "usage_001",
                      "units": "10",
                      "account": { "used": "10", "remaining": "9990" },
                      "user": { "used": "10", "remaining": "990" }
                    }
                  },
                  "rejected": {
                    "summary": "Rejected by the user monthly allowance",
                    "value": {
                      "accepted": false,
                      "requestId": "usage_002",
                      "units": "10",
                      "account": { "used": "10", "remaining": "9990" },
                      "user": { "used": "1000", "remaining": "0" },
                      "rejection": { "scope": "USER", "rule": "MONTHLY_ALLOWANCE" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/IdempotencyConflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/usage/account": {
      "get": {
        "tags": ["Usage"],
        "summary": "Get account usage",
        "description": "Returns the account's counter for a UTC month, evaluated against its current account plan limit.",
        "operationId": "getAccountUsage",
        "parameters": [
          { "$ref": "#/components/parameters/Month" }
        ],
        "responses": {
          "200": {
            "description": "Account usage for the requested or current UTC month.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccountUsageResponse" },
                "example": {
                  "accountId": "f4f734c2-ff65-4aac-9da9-64583c476c92",
                  "month": "2026-10",
                  "used": "125",
                  "monthlyLimit": "10000",
                  "remaining": "9875"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/usage/users/{externalUserId}": {
      "get": {
        "tags": ["Usage"],
        "summary": "Get user usage",
        "description": "Returns a tenant-owned user's counter for a UTC month, evaluated against the user's current plan limit.",
        "operationId": "getUserUsage",
        "parameters": [
          { "$ref": "#/components/parameters/ExternalUserId" },
          { "$ref": "#/components/parameters/Month" }
        ],
        "responses": {
          "200": {
            "description": "User usage for the requested or current UTC month.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserUsageResponse" },
                "example": {
                  "externalUserId": "user_001",
                  "month": "2026-10",
                  "used": "125",
                  "monthlyLimit": "1000",
                  "remaining": "875"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/usage/history": {
      "get": {
        "tags": ["Usage"],
        "summary": "Get usage decision history",
        "description": "Returns newest-first accepted and rejected request snapshots belonging to the authenticated account.",
        "operationId": "getUsageHistory",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" },
          {
            "name": "externalUserId",
            "in": "query",
            "required": false,
            "description": "Filter by tenant-scoped external user identifier.",
            "schema": { "type": "string", "minLength": 1 },
            "example": "user_001"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/UsageStatus" },
            "example": "ACCEPTED"
          },
          { "$ref": "#/components/parameters/Month" }
        ],
        "responses": {
          "200": {
            "description": "Paginated usage decision history.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UsageHistoryResponse" },
                "example": {
                  "items": [
                    {
                      "requestId": "usage_001",
                      "externalUserId": "user_001",
                      "units": "10",
                      "status": "ACCEPTED",
                      "rejection": null,
                      "createdAt": "2026-10-16T09:15:00.000Z",
                      "account": { "usedAfter": "10", "remainingAfter": "9990" },
                      "user": { "usedAfter": "10", "remainingAfter": "990" }
                    }
                  ],
                  "page": 1,
                  "limit": 20,
                  "total": 1
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "One-time-issued account API key. The raw key is never stored by the service."
      }
    },
    "parameters": {
      "ExternalUserId": {
        "name": "externalUserId",
        "in": "path",
        "required": true,
        "description": "External identifier scoped to the authenticated account.",
        "schema": { "type": "string", "minLength": 1 },
        "example": "user_001"
      },
      "PlanId": {
        "name": "planId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" },
        "example": "6b2cd0aa-2ac9-45e9-b54d-847543f838f7"
      },
      "Month": {
        "name": "month",
        "in": "query",
        "required": false,
        "description": "UTC calendar month. Defaults to the current UTC month.",
        "schema": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "example": "2026-10"
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "default": 1 },
        "example": 1
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
        "example": 20
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["ok"] }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },
      "RateLimitError": {
        "type": "object",
        "required": ["statusCode", "error", "message"],
        "properties": {
          "statusCode": { "type": "integer", "enum": [429] },
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "PlanReference": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        }
      },
      "Plan": {
        "allOf": [
          { "$ref": "#/components/schemas/PlanReference" },
          {
            "type": "object",
            "required": ["scope", "monthlyAllowance", "maxUnitsPerRequest", "isPredefined"],
            "properties": {
              "scope": { "$ref": "#/components/schemas/QuotaScope" },
              "monthlyAllowance": { "$ref": "#/components/schemas/BigIntString" },
              "maxUnitsPerRequest": { "$ref": "#/components/schemas/BigIntString" },
              "isPredefined": { "type": "boolean" }
            }
          }
        ]
      },
      "QuotaScope": {
        "type": "string",
        "enum": ["ACCOUNT", "USER"]
      },
      "UsageStatus": {
        "type": "string",
        "enum": ["ACCEPTED", "REJECTED"]
      },
      "RejectionRule": {
        "type": "string",
        "enum": ["MONTHLY_ALLOWANCE", "MAX_UNITS_PER_REQUEST"]
      },
      "BigIntString": {
        "type": "string",
        "pattern": "^\\d+$",
        "description": "Non-negative PostgreSQL BIGINT serialized as a decimal string."
      },
      "CreateAccountRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "description": "Account name; surrounding whitespace is trimmed." }
        }
      },
      "CreateAccountResponse": {
        "type": "object",
        "required": ["account", "apiKey"],
        "properties": {
          "account": {
            "allOf": [
              { "$ref": "#/components/schemas/Account" },
              {
                "type": "object",
                "required": ["plan"],
                "properties": { "plan": { "$ref": "#/components/schemas/PlanReference" } }
              }
            ]
          },
          "apiKey": {
            "type": "string",
            "readOnly": true,
            "description": "Raw API key returned once. Store it securely; it cannot be retrieved later."
          }
        }
      },
      "Account": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        }
      },
      "AuthenticatedAccountResponse": {
        "type": "object",
        "required": ["account"],
        "properties": { "account": { "$ref": "#/components/schemas/Account" } }
      },
      "AccountWithPlanResponse": {
        "type": "object",
        "required": ["account"],
        "properties": {
          "account": {
            "allOf": [
              { "$ref": "#/components/schemas/Account" },
              {
                "type": "object",
                "required": ["plan"],
                "properties": { "plan": { "$ref": "#/components/schemas/PlanReference" } }
              }
            ]
          }
        }
      },
      "ChangePlanRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["planId"],
        "properties": { "planId": { "type": "string", "format": "uuid" } }
      },
      "CreateUserRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["externalUserId"],
        "properties": {
          "externalUserId": { "type": "string", "minLength": 1, "description": "Identifier unique within the authenticated account." }
        }
      },
      "UserWithPlanResponse": {
        "type": "object",
        "required": ["user"],
        "properties": {
          "user": {
            "type": "object",
            "required": ["id", "externalUserId", "plan"],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "externalUserId": { "type": "string" },
              "plan": { "$ref": "#/components/schemas/PlanReference" }
            }
          }
        }
      },
      "CreatePlanRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scope", "monthlyAllowance", "maxUnitsPerRequest"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "scope": { "$ref": "#/components/schemas/QuotaScope" },
          "monthlyAllowance": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "maxUnitsPerRequest": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      },
      "UpdatePlanRequest": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "monthlyAllowance": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "maxUnitsPerRequest": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      },
      "PlanResponse": {
        "type": "object",
        "required": ["plan"],
        "properties": { "plan": { "$ref": "#/components/schemas/Plan" } }
      },
      "PlanListResponse": {
        "type": "object",
        "required": ["plans"],
        "properties": {
          "plans": { "type": "array", "items": { "$ref": "#/components/schemas/Plan" } }
        }
      },
      "ConsumeUsageRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["userId", "units", "requestId"],
        "properties": {
          "userId": { "type": "string", "minLength": 1, "description": "Tenant-scoped external user identifier." },
          "units": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "requestId": { "type": "string", "minLength": 1, "description": "Account-scoped idempotency identifier." }
        }
      },
      "UsageCounterDecision": {
        "type": "object",
        "required": ["used", "remaining"],
        "properties": {
          "used": { "$ref": "#/components/schemas/BigIntString" },
          "remaining": { "$ref": "#/components/schemas/BigIntString" }
        }
      },
      "UsageDecision": {
        "type": "object",
        "required": ["accepted", "requestId", "units", "account", "user"],
        "properties": {
          "accepted": { "type": "boolean" },
          "requestId": { "type": "string" },
          "units": { "$ref": "#/components/schemas/BigIntString" },
          "account": { "$ref": "#/components/schemas/UsageCounterDecision" },
          "user": { "$ref": "#/components/schemas/UsageCounterDecision" },
          "rejection": {
            "type": "object",
            "required": ["scope", "rule"],
            "properties": {
              "scope": { "$ref": "#/components/schemas/QuotaScope" },
              "rule": { "$ref": "#/components/schemas/RejectionRule" }
            }
          }
        }
      },
      "AccountUsageResponse": {
        "type": "object",
        "required": ["accountId", "month", "used", "monthlyLimit", "remaining"],
        "properties": {
          "accountId": { "type": "string", "format": "uuid" },
          "month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
          "used": { "$ref": "#/components/schemas/BigIntString" },
          "monthlyLimit": { "$ref": "#/components/schemas/BigIntString" },
          "remaining": { "$ref": "#/components/schemas/BigIntString" }
        }
      },
      "UserUsageResponse": {
        "type": "object",
        "required": ["externalUserId", "month", "used", "monthlyLimit", "remaining"],
        "properties": {
          "externalUserId": { "type": "string" },
          "month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
          "used": { "$ref": "#/components/schemas/BigIntString" },
          "monthlyLimit": { "$ref": "#/components/schemas/BigIntString" },
          "remaining": { "$ref": "#/components/schemas/BigIntString" }
        }
      },
      "UsageHistoryItem": {
        "type": "object",
        "required": ["requestId", "externalUserId", "units", "status", "rejection", "createdAt", "account", "user"],
        "properties": {
          "requestId": { "type": "string" },
          "externalUserId": { "type": "string" },
          "units": { "$ref": "#/components/schemas/BigIntString" },
          "status": { "$ref": "#/components/schemas/UsageStatus" },
          "rejection": {
            "nullable": true,
            "allOf": [
              {
                "type": "object",
                "required": ["scope", "rule"],
                "properties": {
                  "scope": { "$ref": "#/components/schemas/QuotaScope" },
                  "rule": { "$ref": "#/components/schemas/RejectionRule" }
                }
              }
            ]
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "account": { "$ref": "#/components/schemas/UsageHistoryCounter" },
          "user": { "$ref": "#/components/schemas/UsageHistoryCounter" }
        }
      },
      "UsageHistoryCounter": {
        "type": "object",
        "required": ["usedAfter", "remainingAfter"],
        "properties": {
          "usedAfter": { "$ref": "#/components/schemas/BigIntString" },
          "remainingAfter": { "$ref": "#/components/schemas/BigIntString" }
        }
      },
      "UsageHistoryResponse": {
        "type": "object",
        "required": ["items", "page", "limit", "total"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/UsageHistoryItem" } },
          "page": { "type": "integer", "minimum": 1 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "total": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request body, path parameter, or query parameters are invalid.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Invalid request" } } }
      },
      "Unauthorized": {
        "description": "The x-api-key header is missing, invalid, or revoked.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Unauthorized" } } }
      },
      "Forbidden": {
        "description": "The requested operation is forbidden, such as updating a predefined plan.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Predefined plans are read-only" } } }
      },
      "NotFound": {
        "description": "The tenant-scoped resource does not exist or is not accessible.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Not found" } } }
      },
      "Conflict": {
        "description": "A uniqueness conflict occurred.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Resource already exists" } } }
      },
      "IdempotencyConflict": {
        "description": "The requestId was previously used with a different user or units value.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Idempotency conflict" } } }
      },
      "InternalError": {
        "description": "An unexpected internal error occurred. Database details are not exposed.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Internal server error" } } }
      }
    }
  }
}
