{
  "name": "usage-metering-and-quota-service",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service foundation for usage metering and quota management.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "npm --prefix client run build",
    "start": "node dist/server.js",
    "test:accounts": "tsx --test test/accounts.integration.test.ts",
    "test:account-rate-limit": "tsx --test test/account-rate-limit.integration.test.ts",
    "test:auth": "tsx --test test/api-key-auth.integration.test.ts",
    "test:static-security": "tsx --test test/static-security.integration.test.ts",
    "test:users": "tsx --test test/users.integration.test.ts",
    "test:user-plan": "tsx --test test/user-plan.integration.test.ts",
    "test:plans": "tsx --test test/plans.integration.test.ts",
    "test:account-plan": "tsx --test test/account-plan.integration.test.ts",
    "test:usage": "tsx --test test/usage.integration.test.ts",
    "test:plan-concurrency": "tsx --test test/plan-concurrency.integration.test.ts",
    "test:quota-edge-cases": "tsx --test test/quota-edge-cases.integration.test.ts",
    "test:concurrency-manual": "tsx scripts/concurrency-check.ts",
    "test:usage-read": "tsx --test test/usage-read.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "^10.1.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "5.12.7",
    "pg": "^8.16.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
