{
  "info": {
    "_postman_id": "b6946088-f07d-46a6-a4d1-e290d6fe3a10",
    "name": "Usage Metering and Quota Service",
    "description": "Manual exploration collection for the public quota-service API. Create Account captures its one-time key into the selected local Postman environment. No credential is committed in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "x-api-key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Public process-level health check."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('apiKey', body.apiKey);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Demo {{$timestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            },
            "description": "Creates an account and saves its one-time API key into the active local environment."
          },
          "response": []
        },
        {
          "name": "Get Authenticated Account",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": ["{{baseUrl}}"],
              "path": ["me"]
            }
          },
          "response": []
        },
        {
          "name": "Change Account Plan",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/account/plan",
              "host": ["{{baseUrl}}"],
              "path": ["account", "plan"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalUserId\": \"{{userId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          },
          "response": []
        },
        {
          "name": "Change User Plan",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/plan",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "plan"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Plans",
      "item": [
        {
          "name": "List Available Plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plans",
              "host": ["{{baseUrl}}"],
              "path": ["plans"]
            }
          },
          "response": []
        },
        {
          "name": "Create Custom Plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set('planId', pm.response.json().plan.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Gold {{$timestamp}}\",\n  \"scope\": \"USER\",\n  \"monthlyAllowance\": 5000,\n  \"maxUnitsPerRequest\": 100\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/plans",
              "host": ["{{baseUrl}}"],
              "path": ["plans"]
            },
            "description": "Creates a custom plan and saves its id into planId."
          },
          "response": []
        },
        {
          "name": "Update Custom Plan",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monthlyAllowance\": 7500,\n  \"maxUnitsPerRequest\": 150\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/plans/{{planId}}",
              "host": ["{{baseUrl}}"],
              "path": ["plans", "{{planId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Usage",
      "item": [
        {
          "name": "Consume Usage",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"units\": 10,\n  \"requestId\": \"postman_{{$guid}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/usage/consume",
              "host": ["{{baseUrl}}"],
              "path": ["usage", "consume"]
            }
          },
          "response": []
        },
        {
          "name": "Get Account Usage",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usage/account",
              "host": ["{{baseUrl}}"],
              "path": ["usage", "account"]
            }
          },
          "response": []
        },
        {
          "name": "Get User Usage",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usage/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["usage", "users", "{{userId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get Usage History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usage/history?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["usage", "history"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "externalUserId", "value": "{{userId}}", "disabled": true },
                { "key": "status", "value": "ACCEPTED", "disabled": true },
                { "key": "month", "value": "2026-10", "disabled": true }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://quota-fts.duckdns.org", "type": "string" },
    { "key": "apiKey", "value": "", "type": "string" },
    { "key": "userId", "value": "user_001", "type": "string" },
    { "key": "planId", "value": "", "type": "string" }
  ]
}
