{
  "name": "usage-metering-and-quota-service",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service foundation for usage metering and quota management.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:accounts": "tsx --test test/accounts.integration.test.ts",
    "test:auth": "tsx --test test/api-key-auth.integration.test.ts",
    "test:users": "tsx --test test/users.integration.test.ts",
    "test:user-plan": "tsx --test test/user-plan.integration.test.ts",
    "test:plans": "tsx --test test/plans.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
